{
  "name": "harpy-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx src/db/migrate.ts && next start",
    "worker": "tsx src/worker/main.ts",
    "worker:once": "tsx src/worker/run-once.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:unit": "node scripts/verify-release.mjs units",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:test",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.4.6",
    "p-limit": "7.3.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.1"
  }
}
