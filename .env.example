# ==============================================================================
# Harpy Radar - Environment Configuration Template
# ==============================================================================

# Port Bindings (Defaults strictly to localhost for security)
POSTGRES_PORT_BINDING=127.0.0.1:5433
WEB_PORT_BINDING=127.0.0.1:3000

# Database (PostgreSQL)
# - Local Docker: default localhost:5433 URL without SSL
# - Vercel (web read-only): Supabase Transaction Pooler (port 6543)
# - GitHub Actions (worker:once & migrations using advisory locks): Supabase Session Pooler (port 5432, IPv4)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_local_password
POSTGRES_DB=harpy_radar
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
DB_POOL_MAX=5
DATABASE_SSL=auto

# Worker Scheduling & Timezone
APP_TIMEZONE=America/Caracas
RATE_OFFICIAL_SYNC_CRON=0 30 17,19 * * 1-5
RATE_PARALLEL_SYNC_CRON=0 0 9,13,17 * * *
BAHIA_CRON=0 30 6 * * *
RIOMARKET_CRON=0 35 6 * * *
FARMATODO_CRON=0 40 6 * * *
CENTRAL_MADEIRENSE_CRON=0 45 6 * * *
PUNTO_AL_MAYOR_CRON=0 50 6 * * *
VIVA_CRON=0 55 6 * * *
LOCATEL_CRON=0 0 7 * * *
SCRAPE_CONCURRENCY=2
SCRAPE_DELAY_MS=400

# Retailer Source Connectors
SOURCE_BAHIA_ENABLED=true
SOURCE_RIOMARKET_ENABLED=true
SOURCE_FARMATODO_ENABLED=true
SOURCE_CENTRAL_MADEIRENSE_ENABLED=true
SOURCE_PUNTO_AL_MAYOR_ENABLED=true
SOURCE_VIVA_ENABLED=true
SOURCE_LOCATEL_ENABLED=true
CENTRAL_MADEIRENSE_BASE_URL=https://tucentralonline.com/Maiquetia-53

# Farmatodo Public Storefront Algolia Config
FARMATODO_ALGOLIA_APP_ID=VCOJEYD2PO
FARMATODO_ALGOLIA_API_KEY=869a91e98550dd668b8b1dc04bca9011
FARMATODO_ALGOLIA_INDEX=products-venezuela

# Optional Custom CA Bundle/PEM for BCV SSL Verification
BCV_CA_CERT=
BCV_CA_BUNDLE=

# Gemini
GEMINI_API_KEY="YourGeminiApiKey"
